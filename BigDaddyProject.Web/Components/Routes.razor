<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not Found</PageTitle>
        <div class="not-found-page">
            <div class="not-found-content">
                <div class="not-found-icon">🔍</div>
                <h1>Page Not Found</h1>
                <p>The page you requested does not exist.</p>
                <a href="/admin/users" class="btn-home">← Go to Dashboard</a>
            </div>
        </div>
    </NotFound>
</Router>

<style>
    .not-found-page {
        min-height: 100vh; display: flex; align-items: center;
        justify-content: center; background: #f5f6fa;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }
    .not-found-content { text-align: center; padding: 2rem; }
    .not-found-icon { font-size: 4rem; margin-bottom: 1rem; }
    .not-found-content h1 { font-size: 1.5rem; font-weight: 700; color: #333; margin-bottom: 0.5rem; }
    .not-found-content p { color: #666; font-size: 0.875rem; margin-bottom: 2rem; }
    .btn-home {
        background: #1a237e; color: white;
        padding: 10px 24px; border-radius: 6px;
        text-decoration: none; font-size: 0.875rem;
    }
</style>