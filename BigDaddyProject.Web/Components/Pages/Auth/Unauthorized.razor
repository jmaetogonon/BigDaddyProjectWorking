@page "/unauthorized"

<PageTitle>Access Denied</PageTitle>

<div class="unauth-page">
    <div class="unauth-box">
        <div class="unauth-icon">🔒</div>
        <h1>Access Denied</h1>
        <p>
            You do not have permission to view this page.<br/>
            Contact your administrator if you believe this is an error.
        </p>
        <div class="unauth-actions">
            <a href="/admin/users" class="btn-home">← Go to Dashboard</a>
            <a href="/login" class="btn-login">Log In Again</a>
        </div>
    </div>
</div>

<style>
    .unauth-page {
        min-height: 100vh; display: flex; align-items: center;
        justify-content: center; background: #f5f6fa;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }
    .unauth-box { text-align: center; max-width: 420px; padding: 2rem; }
    .unauth-icon { font-size: 4rem; margin-bottom: 1rem; }
    .unauth-box h1 { font-size: 1.5rem; font-weight: 700; color: #333; margin-bottom: 0.75rem; }
    .unauth-box p { color: #666; font-size: 0.875rem; line-height: 1.6; margin-bottom: 2rem; }
    .unauth-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    .btn-home { background: #1a237e; color: white; padding: 10px 24px; border-radius: 6px; text-decoration: none; font-size: 0.875rem; }
    .btn-login { background: white; color: #1a237e; padding: 10px 24px; border-radius: 6px; border: 1px solid #1a237e; text-decoration: none; font-size: 0.875rem; }
</style>