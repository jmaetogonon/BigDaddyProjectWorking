@page "/admin/change-password"
@using BigDaddyProject.Application.DTOs
@using BigDaddyProject.Application.Interfaces
@using BigDaddyProject.Web.Components.Layout
@using BigDaddyProject.Web.Services
@inject IAuthService AuthService
@inject SessionStorageService Session
@inject NavigationManager Nav
@rendermode InteractiveServer

<AdminLayout Breadcrumbs="_bc">
    <Body>
        <!-- Matches screenshot 2: plain white background, three labeled inputs, navy button -->
        <div class="cp-wrap">

            @if (!string.IsNullOrEmpty(_err))
            {
                <div class="cp-alert cp-alert-err">@_err</div>
            }
            @if (!string.IsNullOrEmpty(_ok))
            {
                <div class="cp-alert cp-alert-ok">@_ok</div>
            }

            <div class="cp-section">
                <label class="cp-label">Old Password</label>
                <input @bind="_old" type="password" class="cp-input"
                       placeholder="Password length should not be less than 6" />
            </div>

            <div class="cp-section">
                <label class="cp-label">New Password</label>
                <input @bind="_new" type="password" class="cp-input"
                       placeholder="Password length should not be less than 6" />
            </div>

            <div class="cp-section">
                <label class="cp-label">Confirm New Password</label>
                <input @bind="_confirm" type="password" class="cp-input"
                       placeholder="Password length should not be less than 6" />
            </div>

            <div class="cp-divider"></div>

            <button class="cp-btn" @onclick="SubmitAsync" disabled="@_saving">
                @(_saving ? "Changing..." : "Change Password")
            </button>
        </div>
    </Body>
</AdminLayout>

<style>
    /* Matches screenshot 2 exactly */
    .cp-wrap {
        background: white;
        min-height: calc(100vh - 56px - 3rem);
        padding: 2rem 2.5rem;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .cp-alert {
        margin-bottom: 1.5rem; padding: 0.75rem 1rem;
        border-radius: 6px; font-size: 0.875rem;
    }
    .cp-alert-err { background: #fff0f0; border: 1px solid #ffcdd2; color: #c62828; }
    .cp-alert-ok  { background: #f0fff4; border: 1px solid #c8e6c9; color: #2e7d32; }

    .cp-section { margin-bottom: 1.5rem; }

    .cp-label {
        display: block;
        font-size: 0.95rem; font-weight: 500; color: #222;
        margin-bottom: 0.6rem;
    }

    .cp-input {
        width: 320px; height: 40px; max-width: 100%;
        padding: 0 12px;
        border: 1px solid #d0d0d0; border-radius: 5px;
        font-size: 0.875rem; color: #333; outline: none;
        background: white;
        transition: border-color 0.2s;
    }
    .cp-input:focus { border-color: #1a237e; }
    .cp-input::placeholder { color: #bbb; }

    .cp-divider {
        border: none; border-top: 1px solid #e8e8e8;
        margin: 1.5rem 0;
        width: 100%; max-width: 600px;
    }

    .cp-btn {
        background: #1a237e; color: white;
        border: none; border-radius: 5px;
        padding: 10px 32px; font-size: 0.95rem; font-weight: 600;
        cursor: pointer; transition: background 0.2s;
    }
    .cp-btn:hover:not(:disabled) { background: #283593; }
    .cp-btn:disabled { opacity: 0.7; cursor: not-allowed; }
</style>

@code {
    private List<(string, string, bool)> _bc = new()
    {
        ("Dashboard", "/admin", false),
        ("Change Password", "/admin/change-password", true)
    };

    private string _old = "", _new = "", _confirm = "";
    private string? _err, _ok;
    private bool _saving;

    private async Task SubmitAsync()
    {
        _err = null; _ok = null;

        if (string.IsNullOrWhiteSpace(_old) ||
            string.IsNullOrWhiteSpace(_new) ||
            string.IsNullOrWhiteSpace(_confirm))
        {
            _err = "All fields are required.";
            return;
        }

        if (_new != _confirm)
        {
            _err = "New password and confirm password do not match.";
            return;
        }

        if (_new.Length < 8)
        {
            _err = "Password must be at least 8 characters.";
            return;
        }

        var session = await Session.GetAsync();
        if (session == null) { Nav.NavigateTo("/login"); return; }

        _saving = true;
        var r = await AuthService.ChangePasswordAsync(
            session.UserId, new ChangePasswordRequest(_old, _new, _confirm));
        _saving = false;

        if (!r.IsSuccess) { _err = r.Error; return; }

        _ok = "Password changed successfully.";
        _old = _new = _confirm = "";
    }
}