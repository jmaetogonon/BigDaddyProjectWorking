@page "/forgot-password"
@using BigDaddyProject.Application.DTOs
@using BigDaddyProject.Application.Interfaces
@inject IAuthService AuthService
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Forgot Password — BigDaddy</PageTitle>

<div class="login-page">
    <header class="login-header">
        <div class="login-brand">
            <span class="brand-main">BigDaddy Admin Portal</span>
        </div>
    </header>

    <div class="login-center">
        <div class="login-card">
            <h2 class="card-title">Forgot Password</h2>

            @if (!_sent)
            {
                @if (!string.IsNullOrEmpty(_err))
                {
                    <div class="login-error">@_err</div>
                }
                <p class="card-desc">
                    Enter your registered email address and we'll send you
                    a password reset link.
                </p>
                <div class="login-field">
                    <input @bind="_email" type="email" class="field-input"
                           style="padding-left: 12px"
                           placeholder="Your email address" />
                </div>
                <button class="btn-login" @onclick="SendAsync" disabled="@_sending">
                    @(_sending ? "Sending..." : "Send Reset Link")
                </button>
                <div class="login-links">
                    <a href="/login">← Back to Login</a>
                </div>
            }
            else
            {
                <div class="sent-confirm">
                    <div class="sent-icon">📧</div>
                    <p>
                        If your email is registered, you will receive
                        reset instructions shortly. Check your inbox.
                    </p>
                    <a href="/login" class="back-link">← Back to Login</a>
                </div>
            }
        </div>
    </div>

    <footer class="login-footer">
        <span>©2025 BigDaddy Portal</span>
    </footer>
</div>

<style>
    .login-page { min-height: 100vh; display: flex; flex-direction: column; background: linear-gradient(160deg, #1a2a4a 0%, #2c4a7a 50%, #1a3a6a 100%); font-family: 'Segoe UI', system-ui, sans-serif; }
    .login-header { height: 56px; background: #1a237e; display: flex; align-items: center; padding: 0 2rem; }
    .brand-main { color: white; font-size: 1rem; font-weight: 700; }
    .login-center { flex: 1; display: flex; align-items: center; justify-content: center; padding: 2rem; }
    .login-card { background: white; border-radius: 12px; padding: 2.5rem 2rem; width: 100%; max-width: 380px; box-shadow: 0 20px 60px rgba(0,0,0,0.4); display: flex; flex-direction: column; gap: 1rem; }
    .card-title { font-size: 1.1rem; font-weight: 600; color: #333; }
    .card-desc { font-size: 0.875rem; color: #666; line-height: 1.6; }
    .login-error { background: #fff0f0; border: 1px solid #ffcdd2; color: #c62828; padding: 0.75rem 1rem; border-radius: 6px; font-size: 0.875rem; }
    .login-field { border: 1px solid #e0e0e0; border-radius: 6px; overflow: hidden; }
    .login-field:focus-within { border-color: #1a237e; }
    .field-input { width: 100%; border: none; outline: none; padding: 0.75rem; font-size: 0.875rem; color: #333; }
    .btn-login { background: #1a237e; color: white; border: none; border-radius: 6px; padding: 0.85rem; font-size: 0.95rem; font-weight: 600; cursor: pointer; }
    .btn-login:disabled { opacity: 0.7; cursor: not-allowed; }
    .login-links { text-align: center; font-size: 0.875rem; }
    .login-links a { color: #1a237e; text-decoration: none; }
    .sent-confirm { text-align: center; padding: 1rem 0; display: flex; flex-direction: column; gap: 1rem; }
    .sent-icon { font-size: 2.5rem; }
    .sent-confirm p { font-size: 0.875rem; color: #555; line-height: 1.6; }
    .back-link { display: inline-block; color: #1a237e; font-size: 0.875rem; text-decoration: none; }
    .login-footer { background: #1a237e; padding: 0.75rem 2rem; color: rgba(255,255,255,0.7); font-size: 0.8rem; }
</style>

@code {
    private string _email = "";
    private string? _err;
    private bool _sending, _sent;

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_email)) { _err = "Email is required."; return; }
        _sending = true;
        await AuthService.ForgotPasswordAsync(new ForgotPasswordRequest(_email));
        _sending = false;
        _sent = true;
    }
}