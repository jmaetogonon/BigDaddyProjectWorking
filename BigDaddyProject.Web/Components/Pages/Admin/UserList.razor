@page "/admin/users"
@using BigDaddyProject.Application.DTOs
@using BigDaddyProject.Application.Interfaces
@using BigDaddyProject.Web.Services
@using BigDaddyProject.Web.Components.Layout
@inject IUserService UserService
@inject SessionStorageService Session
@inject NavigationManager Nav
@rendermode InteractiveServer

<AdminLayout Breadcrumbs="_bc">
    <Body>
        <div class="page-card">
            <h2 class="page-title">User List</h2>

            <!-- ── Filter Bar ── -->
            <div class="filter-bar">
                <div class="filter-field">
                    <label>Name</label>
                    <input @bind="_q.Name" @bind:event="oninput" class="f-ctrl" />
                </div>
                <div class="filter-field">
                    <label>Email</label>
                    <input @bind="_q.Email" @bind:event="oninput" class="f-ctrl" />
                </div>
                <div class="filter-field">
                    <label>Reg Num</label>
                    <input @bind="_q.RegNum" @bind:event="oninput" class="f-ctrl" />
                </div>
                <div class="filter-field">
                    <label>Mobile</label>
                    <input @bind="_q.Mobile" @bind:event="oninput" class="f-ctrl" />
                </div>
                <div class="filter-field">
                    <label>Active</label>
                    <select @bind="_q.Status" class="f-ctrl">
                        <option value="">Select</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
                <div class="filter-actions">
                    <button class="btn-search" @onclick="SearchAsync">Search</button>
                    <button class="btn-clear"  @onclick="ClearAsync">Clear</button>
                    <button class="btn-action" @onclick="LoadAsync">Refresh</button>
                    <button class="btn-export" @onclick="ExportAsync">Export to Excel</button>
                </div>
            </div>

            <!-- ── Table ── -->
            <div class="table-scroll">
                @if (_loading)
                {
                    <div class="table-loading">
                        <div class="dots"><span></span><span></span><span></span></div>
                    </div>
                }
                else
                {
                    <table class="data-table" id="user-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Mobile</th>
                                <th>Email</th>
                                <th>Reg Number</th>
                                <th class="col-center">Active</th>
                                <th class="col-center">Multi Terminal</th>
                                <th>Password</th>
                                <th>Expiration Date</th>
                                <th>Last Login Time</th>
                                <th class="col-center">Edit</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!_rows.Any())
                            {
                                <tr>
                                    <td colspan="10" class="empty-row">
                                        No users found. Try adjusting your search.
                                    </td>
                                </tr>
                            }
                            @foreach (var u in _rows)
                            {
                                <tr class="@(u.IsActive ? "" : "row-inactive")">
                                    <td class="td-name">@u.Name</td>
                                    <td>@u.Mobile</td>
                                    <td class="td-email">@u.Email</td>
                                    <td>@u.RegNumber</td>
                                    <td class="col-center">
                                        @if (u.IsActive)
                                        {
                                            <span class="icon-check">✓</span>
                                        }
                                        else
                                        {
                                            <span class="icon-cross">✕</span>
                                        }
                                    </td>
                                    <td class="col-center">
                                        @if (u.MultiTerminal)
                                        {
                                            <span class="icon-check">✓</span>
                                        }
                                        else
                                        {
                                            <span class="icon-cross">✕</span>
                                        }
                                    </td>
                                    <td class="td-pwd">••••••••</td>
                                    <td>@u.ExpirationDate?.ToString("yyyy-MM-dd")</td>
                                    <td>@u.LastLoginTime?.ToString("yyyy-MM-dd")</td>
                                    <td class="col-center">
                                        <div class="action-group">
                                            <button class="btn-row-edit"
                                                    @onclick="() => GoEdit(u.Id)">Edit</button>
                                            <button class="btn-row-teams"
                                                    @onclick="() => OpenTeamsModal(u)">Teams</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <!-- ── Paginator ── -->
            @if (_paged != null && _paged.TotalCount > 0)
            {
                <div class="paginator">
                    <button class="page-btn" @onclick="PrevPage"
                            disabled="@(_q.Page <= 1)">‹</button>

                    @foreach (var p in PageNumbers())
                    {
                        @if (p == -1)
                        {
                            <span class="page-ellipsis">•••</span>
                        }
                        else
                        {
                            <button class="page-btn @(p == _q.Page ? "page-active" : "")"
                                    @onclick="() => GoPage(p)">@p</button>
                        }
                    }

                    <button class="page-btn" @onclick="NextPage"
                            disabled="@(_q.Page >= _paged.TotalPages)">›</button>

                    <select class="page-size" @bind="_q.PageSize" @bind:after="LoadAsync">
                        <option value="10">10/page</option>
                        <option value="20">20/page</option>
                        <option value="50">50/page</option>
                    </select>

                    <span class="total-label">Total @_paged.TotalCount</span>
                </div>
            }
        </div>

        <!-- ── Teams Modal ── -->
        @if (_teamsModal)
        {
            <div class="modal-bg" @onclick="CloseTeamsModal">
                <div class="modal-box" @onclick:stopPropagation="true">
                    <div class="modal-head">
                        <span>Manage Teams — @_modalUser?.Name</span>
                        <button class="modal-close" @onclick="CloseTeamsModal">✕</button>
                    </div>
                    <div class="modal-body">
                        @if (!_allTeams.Any())
                        {
                            <p class="text-muted">No teams available. Create teams first.</p>
                        }
                        @foreach (var t in _allTeams)
                        {
                            <label class="check-row">
                                <input type="checkbox"
                                       checked="@_selTeams.Contains(t.Id)"
                                       @onchange="() => ToggleTeam(t.Id)" />
                                <span>@t.Name</span>
                                <span class="tag-roles">
                                    @string.Join(", ", t.Roles)
                                </span>
                            </label>
                        }
                    </div>
                    <div class="modal-foot">
                        <button class="btn-save" @onclick="SaveTeamsAsync">Save</button>
                        <button class="btn-cancel" @onclick="CloseTeamsModal">Cancel</button>
                    </div>
                </div>
            </div>
        }
    </Body>
</AdminLayout>

<style>
    /* Card */
    .page-card { background: white; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,0.06); overflow: hidden; }
    .page-title { font-size: 1.1rem; font-weight: 600; color: #333; padding: 1.25rem 1.5rem; border-bottom: 1px solid #f0f0f0; }

    /* Filters */
    .filter-bar { padding: 1rem 1.5rem; display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px; background: #fafafa; border-bottom: 1px solid #f0f0f0; }
    .filter-field { display: flex; flex-direction: column; gap: 3px; }
    .filter-field label { font-size: 0.78rem; color: #666; font-weight: 500; }
    .f-ctrl { height: 32px; padding: 0 8px; border: 1px solid #ddd; border-radius: 4px; font-size: 0.875rem; color: #333; outline: none; min-width: 110px; }
    .f-ctrl:focus { border-color: #1a237e; }
    .filter-actions { display: flex; align-items: flex-end; gap: 8px; flex-wrap: wrap; }
    .btn-search { height: 32px; padding: 0 18px; background: #1a237e; color: white; border: none; border-radius: 4px; font-size: 0.8rem; cursor: pointer; }
    .btn-search:hover { background: #283593; }
    .btn-clear  { height: 32px; padding: 0 14px; background: white; color: #555; border: 1px solid #ddd; border-radius: 4px; font-size: 0.8rem; cursor: pointer; }
    .btn-action { height: 32px; padding: 0 14px; background: white; color: #555; border: 1px solid #ddd; border-radius: 4px; font-size: 0.8rem; cursor: pointer; }
    .btn-export { height: 32px; padding: 0 14px; background: #2e7d32; color: white; border: none; border-radius: 4px; font-size: 0.8rem; cursor: pointer; }

    /* Table */
    .table-scroll { overflow-x: auto; }
    .table-loading { padding: 3rem; display: flex; align-items: center; justify-content: center; }
    .dots { display: flex; gap: 6px; }
    .dots span { width: 8px; height: 8px; border-radius: 50%; background: #1a237e; animation: bounce 1s infinite; }
    .dots span:nth-child(2) { animation-delay: 0.15s; }
    .dots span:nth-child(3) { animation-delay: 0.3s; }
    @@keyframes bounce { 0%,80%,100% { transform: scale(0.7); } 40% { transform: scale(1); } }

    .data-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; min-width: 900px; }
    .data-table thead tr { background: #fafafa; border-bottom: 1px solid #e8eaed; }
    .data-table th { padding: 10px 12px; text-align: left; font-size: 0.8rem; font-weight: 600; color: #555; white-space: nowrap; }
    .data-table th.col-center { text-align: center; }
    .data-table tbody tr { border-bottom: 1px solid #f0f0f0; transition: background 0.1s; }
    .data-table tbody tr:hover { background: #fafbff; }
    .data-table tbody tr.row-inactive { opacity: 0.6; }
    .data-table td { padding: 10px 12px; vertical-align: middle; }
    .data-table td.col-center { text-align: center; }

    .td-name  { font-weight: 500; }
    .td-email { font-size: 0.8rem; }
    .td-pwd   { color: #aaa; letter-spacing: 2px; }
    .empty-row { text-align: center; color: #999; padding: 3rem; }

    .icon-check { color: #2e7d32; font-weight: bold; font-size: 1rem; }
    .icon-cross { color: #bdbdbd; font-size: 1rem; }

    .action-group { display: flex; gap: 6px; justify-content: center; }
    .btn-row-edit  { padding: 4px 12px; border: 1px solid #1a237e; color: #1a237e; background: white; border-radius: 4px; font-size: 0.775rem; cursor: pointer; }
    .btn-row-edit:hover  { background: #e8eaf6; }
    .btn-row-teams { padding: 4px 12px; border: 1px solid #795548; color: #795548; background: white; border-radius: 4px; font-size: 0.775rem; cursor: pointer; }
    .btn-row-teams:hover { background: #efebe9; }

    /* Paginator */
    .paginator { padding: 1rem 1.5rem; display: flex; align-items: center; gap: 4px; border-top: 1px solid #f0f0f0; }
    .page-btn { min-width: 32px; height: 32px; padding: 0 6px; border: 1px solid #e0e0e0; border-radius: 4px; background: white; cursor: pointer; font-size: 0.875rem; color: #333; }
    .page-btn:hover:not(:disabled) { border-color: #1a237e; color: #1a237e; }
    .page-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .page-active { background: #1a237e !important; color: white !important; border-color: #1a237e !important; }
    .page-ellipsis { padding: 0 4px; color: #aaa; }
    .page-size { margin-left: 8px; height: 32px; padding: 0 8px; border: 1px solid #e0e0e0; border-radius: 4px; font-size: 0.875rem; }
    .total-label { margin-left: 8px; font-size: 0.875rem; color: #666; }

    /* Modal */
    .modal-bg { position: fixed; inset: 0; background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center; z-index: 500; }
    .modal-box { background: white; border-radius: 10px; width: 460px; max-width: 95vw; max-height: 80vh; display: flex; flex-direction: column; box-shadow: 0 20px 60px rgba(0,0,0,0.25); }
    .modal-head { padding: 1rem 1.25rem; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #f0f0f0; font-weight: 600; font-size: 0.95rem; }
    .modal-close { background: none; border: none; cursor: pointer; font-size: 1rem; color: #999; }
    .modal-body { flex: 1; overflow-y: auto; padding: 1rem 1.25rem; }
    .modal-foot { padding: 1rem 1.25rem; border-top: 1px solid #f0f0f0; display: flex; gap: 8px; justify-content: flex-end; }
    .check-row { display: flex; align-items: center; gap: 10px; padding: 8px 0; cursor: pointer; font-size: 0.875rem; border-bottom: 1px solid #f5f5f5; }
    .check-row input { cursor: pointer; }
    .tag-roles { margin-left: auto; font-size: 0.775rem; color: #888; }
    .text-muted { color: #aaa; font-size: 0.875rem; }
    .btn-save { background: #1a237e; color: white; border: none; border-radius: 5px; padding: 8px 22px; cursor: pointer; font-size: 0.875rem; }
    .btn-cancel { background: #f5f5f5; color: #555; border: 1px solid #ddd; border-radius: 5px; padding: 8px 18px; cursor: pointer; font-size: 0.875rem; }
</style>

@code {
    private List<(string, string, bool)> _bc = new()
    {
        ("Dashboard", "/admin", false),
        ("Admin",     "/admin", false),
        ("User Management", "/admin/users", false),
        ("User List", "/admin/users", true)
    };

    private UserListQuery _q = new() { Page = 1, PageSize = 10 };
    private PagedResult<UserListItem>? _paged;
    private List<UserListItem> _rows = new();
    private bool _loading;

    // Teams modal state
    private bool _teamsModal;
    private UserListItem? _modalUser;
    private List<TeamDto> _allTeams = new();
    private HashSet<int> _selTeams = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; StateHasChanged();
        var r = await UserService.GetUsersAsync(_q);
        if (r.IsSuccess)
        {
            _paged = r.Value;
            _rows  = r.Value!.Items;
        }
        _loading = false; StateHasChanged();
    }

    private async Task SearchAsync() { _q.Page = 1; await LoadAsync(); }

    private async Task ClearAsync()
    {
        _q = new UserListQuery { Page = 1, PageSize = _q.PageSize };
        await LoadAsync();
    }

    private void GoEdit(int id) => Nav.NavigateTo($"/admin/users/{id}/edit");

    private void ExportAsync() =>
        Nav.NavigateTo($"/api/users/export?name={_q.Name}&status={_q.Status}", true);

    private async Task OpenTeamsModal(UserListItem u)
    {
        _modalUser = u;
        // Load teams — inject ITeamService if needed
        _allTeams  = new();   // replace with: await _teamService.GetTeamsAsync()
        _selTeams  = new();
        _teamsModal = true;
        StateHasChanged();
    }

    private void CloseTeamsModal() => _teamsModal = false;

    private void ToggleTeam(int id)
    {
        if (!_selTeams.Remove(id)) _selTeams.Add(id);
    }

    private async Task SaveTeamsAsync()
    {
        if (_modalUser != null)
            await UserService.AssignTeamsAsync(_modalUser.Id, _selTeams.ToList());
        CloseTeamsModal();
        await LoadAsync();
    }

    private async Task PrevPage()
    {
        if (_q.Page > 1) { _q.Page--; await LoadAsync(); }
    }

    private async Task NextPage()
    {
        if (_paged != null && _q.Page < _paged.TotalPages)
        { _q.Page++; await LoadAsync(); }
    }

    private async Task GoPage(int p) { _q.Page = p; await LoadAsync(); }

    private List<int> PageNumbers()
    {
        if (_paged == null) return new();
        int total = _paged.TotalPages, cur = _q.Page;
        var pages = new List<int>();
        if (total <= 7) { for (int i = 1; i <= total; i++) pages.Add(i); }
        else
        {
            pages.Add(1);
            if (cur > 3) pages.Add(-1);
            for (int i = Math.Max(2, cur - 1); i <= Math.Min(total - 1, cur + 1); i++)
                pages.Add(i);
            if (cur < total - 2) pages.Add(-1);
            pages.Add(total);
        }
        return pages;
    }
}